{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Wait for Panoptes Service",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/.vscode/wait-for-service.ps1"
            ],
            "presentation": {
                "reveal": "silent",
                "panel": "dedicated"
            },
            "problemMatcher": []
        },
        {
            "label": "Package Debug Build for KDNET Target",
            "type": "process",
            "command": "powershell.exe",
            "args": [
                "-NoProfile",
                "-ExecutionPolicy", "Bypass",
                "-File", "${workspaceFolder}/.vscode/package-target.ps1",
                "-Zip"
            ],
            "problemMatcher": []
        }
    ]
}
