          <mxGeometry height="76.5" width="76.5" x="356" y="744" as="geometry" />
        </mxCell>
        <mxCell id="CXB1Ufp8fhSvT8PdVjaL-8" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=https://cdn2.iconfinder.com/data/icons/file-types-3/32/file_DLL-64.png;" value="Panoptes &#xa;Memory Scan&#xa;(PMem)" vertex="1">
          <mxGeometry height="64" width="64" x="362.25344827586207" y="897.0003448275863" as="geometry" />
        </mxCell>
        <mxCell id="CXB1Ufp8fhSvT8PdVjaL-14" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;connectable=0;noLabel=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Panoptes  Scanner&lt;br&gt;&lt;/h1&gt;&lt;p&gt;The Panoptes scanner tools allows the user to scan files using the command line interface or via a right click on the context menu.&lt;/p&gt;" vertex="1">
          <mxGeometry height="126" width="261" x="-351" y="448" as="geometry" />
        </mxCell>
        <mxCell id="CXB1Ufp8fhSvT8PdVjaL-15" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=https://cdn3.iconfinder.com/data/icons/file-extension-28/267/exe-1024.png;" value="Panoptes CLI Scanner&#xa;" vertex="1">
          <mxGeometry height="76.5" width="76.5" x="116.97" y="460" as="geometry" />
        </mxCell>
        <mxCell id="2Nh9rb_-xzqOD59swjkN-60" edge="1" parent="1" source="2Nh9rb_-xzqOD59swjkN-32" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;flowAnimation=0;flowAnimationDuration=1000;exitX=1;exitY=0.25;exitDx=0;exitDy=0;" target="2Nh9rb_-xzqOD59swjkN-52">
          <mxGeometry relative="1" x="0.0098" as="geometry">
            <Array as="points">
              <mxPoint x="420" y="398.9" />
              <mxPoint x="420" y="272.3" />
            </Array>
            <mxPoint x="382" y="529.0123456790122" as="sourcePoint" />
            <mxPoint x="484" y="345" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="Zq4jkDt9gwI9zMUbK-w_-2" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=https://cdn2.iconfinder.com/data/icons/file-types-3/32/file_DLL-64.png;" value="Panoptes &#xa;AMSI Provider" vertex="1">
          <mxGeometry height="64" width="64" x="453.13" y="592" as="geometry" />
        </mxCell>
        <mxCell id="11LjAQhsMhpzE4_2Gh9C-10" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;connectable=0;noLabel=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Panoptes Service&lt;br&gt;&lt;/h1&gt;&lt;div&gt;The Panoptes Service is the main brain to the whole operation. The service consumes the Kernel Driver Events in real time and also consume ETW events from the User Mode Hook DLLs. When a never before seen executable is ran that isn&#39;t logged in the Rocks Database a request is sent to the Panoptes Yara container to be examined for malicious attributes. Additionally, a memory scanning request may be sent to the Panoptes Extensibility to further examine the memory buffer region. The service communicates containers via gRPC (Protocol Buffers). Near real time responses are sent from the containers back to the service for a termination or not to occur.&lt;/div&gt;" vertex="1">
          <mxGeometry height="193" width="370" x="440" y="367" as="geometry" />
        </mxCell>
