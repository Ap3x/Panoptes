        <mxCell id="11LjAQhsMhpzE4_2Gh9C-8" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;connectable=0;noLabel=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Panoptes User Mode Hooks&lt;br&gt;&lt;/h1&gt;&lt;div&gt;The user mode hook DLLs utilize Microsoft Detours to hook common Windows API that could be used maliciously. Depending on the specific Windows API a post call check will be performed prior to emitting an ETW event. These events are consumed by the Panoptes Service.&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="130" width="330" x="-351" y="574" as="geometry" />
        </mxCell>
