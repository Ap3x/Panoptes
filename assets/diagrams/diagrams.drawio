        </mxCell>
        <mxCell id="11LjAQhsMhpzE4_2Gh9C-7" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;connectable=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Panoptes Container&lt;br&gt;&lt;/h1&gt;The container&#39;s act as a surrogate for the Panoptes Extensibility DLLs and communicate back to the Panoptes Service of the results from the scan." vertex="1">
          <mxGeometry height="108" width="320" x="490" y="739" as="geometry" />
        </mxCell>
        <mxCell id="11LjAQhsMhpzE4_2Gh9C-9" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;connectable=0;noLabel=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Panoptes Linter&lt;br&gt;&lt;/h1&gt;The linter ensures that the supplied Panoptes JSON configuration has all the correct fields and required data to begin operation." vertex="1">
          <mxGeometry height="112" width="261" x="-351" y="209" as="geometry" />
        </mxCell>
        <mxCell id="TchyhdvWaHZOWy362Ce8-2" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=https://cdn3.iconfinder.com/data/icons/file-extension-28/267/exe-1024.png;" value="Panoptes Scanner&#xa;" vertex="1">
          <mxGeometry height="76.5" width="76.5" x="-45" y="460" as="geometry" />
        </mxCell>
        <mxCell id="4dgLIrs-NOxHsrDhryPH-1" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Panoptes Kernel Driver&lt;br&gt;&lt;/h1&gt;The filesystem filter driver is able to listen to specific file system events. In addition, the driver is subscribed to system kernel callbacks to monitor process creation, loading of images, registry changes, object handles. The driver uses an inverted call structure to reply to event requests sent from the Panoptes Service." vertex="1">
          <mxGeometry height="152" width="378" x="427" y="31" as="geometry" />
        </mxCell>
        <mxCell id="4dgLIrs-NOxHsrDhryPH-6" edge="1" parent="1" source="4dgLIrs-NOxHsrDhryPH-5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;startArrow=classic;startFill=1;endArrow=none;endFill=0;" target="2Nh9rb_-xzqOD59swjkN-32">
          <mxGeometry relative="1" x="0.2069" as="geometry">
            <Array as="points">
              <mxPoint x="208.8" y="369" />
              <mxPoint x="208.8" y="418.1" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="4dgLIrs-NOxHsrDhryPH-5" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;strokeWidth=3;" value="RocksDB Databse " vertex="1">
          <mxGeometry height="79.58" width="79.58" x="34.96" y="339.21" as="geometry" />
        </mxCell>
        <mxCell id="4dgLIrs-NOxHsrDhryPH-7" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;connectable=0;noLabel=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Panoptes RocksDB&lt;br&gt;&lt;/h1&gt;Panoptes stores a hash value and information about each file. The information stored includes scan results and basic file info" vertex="1">
          <mxGeometry height="102" width="261" x="-351" y="328" as="geometry" />
        </mxCell>
        <mxCell id="nqpikjvwoDamXcm8Fm9y-3" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=https://cdn4.iconfinder.com/data/icons/it-components-2/24/microchip_processor_chip_cpu-64.png;" value="Panoptes Kernel Driver&#xa;(Main Driver)" vertex="1">
          <mxGeometry height="64" width="64" x="315.50034482758633" y="75.00068965517244" as="geometry" />
        </mxCell>
        <mxCell id="nqpikjvwoDamXcm8Fm9y-11" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;connectable=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Panoptes Extensibility &lt;/h1&gt;&lt;div&gt;Each module provides Panoptes with a method of identifying malicious files or memory buffers on the system.&lt;/div&gt;" vertex="1">
          <mxGeometry height="100" width="320" x="490" y="884" as="geometry" />
        </mxCell>
        <mxCell id="nqpikjvwoDamXcm8Fm9y-14" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;connectable=0;noLabel=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Panoptes Log Files&lt;br&gt;&lt;/h1&gt;&lt;div&gt;The log file(s) contain parsable JSON events on each line detailing an event that was detected from the kernel, user mode hooks, service actions, or extensibility&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="118" width="273" x="537" y="203" as="geometry" />
        </mxCell>
        <mxCell id="CXB1Ufp8fhSvT8PdVjaL-6" edge="1" parent="1" source="CXB1Ufp8fhSvT8PdVjaL-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=3;dashed=1;dashPattern=1 4;flowAnimation=1;" target="CXB1Ufp8fhSvT8PdVjaL-7">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
