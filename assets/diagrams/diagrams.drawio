        <mxCell id="2Nh9rb_-xzqOD59swjkN-66" parent="1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=https://cdn0.iconfinder.com/data/icons/leto-file-formats/64/json_javascript_file_format-64.png;" value="Configuration" vertex="1">
