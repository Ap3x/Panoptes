{
    "Exclusions": [
        "C:\\Windows",
        "C:\\Program Files\\Microsoft Visual Studio\\",
        "C:\\Program Files (x86)\\Microsoft\\",
        "C:\\Users\\Research\\source\\repos\\",
        "C:\\Users\\Development\\AppData\\Local\\Comms\\UnistoreDB\\",
        "C:\\Windows\\ServiceProfiles\\",
        "C:\\Windows\\System32\\config\\",
        "C:\\Users\\Development\\AppData\\Local\\Packages\\",
        "C:\\Program Files\\SplunkUniversalForwarder\\*"
    ],
    "LogExclusions": [
        "C:\\Users\\*\\AppData\\Local\\ConnectedDevicesPlatform\\*",
        "C:\\Windows\\System32\\winevt\\Logs\\*",
        "C:\\Windows\\Prefetch\\*",
        "C:\\Windows\\System32\\config\\*",
        "C:\\ProgramData\\Microsoft\\Windows Defender\\Support\\*",
        "C:\\Windows\\System32\\LogFiles\\",
        "C:\\Users\\*\\AppData\\Local\\Comms\\UnistoreDB\\*",
        "C:\\Users\\*\\AppData\\Local\\Microsoft\\Windows\\WebCache\\*",
        "C:\\ProgramData\\Microsoft\\Diagnosis\\*",
        "C:\\Users\\*\\AppData\\LocalLow\\Microsoft\\CryptnetUrlCache\\MetaData\\*",
        "C:\\Windows\\System32\\UserMgrLog.etl",
        "C:\\$Recycle.Bin\\",
        "C:\\Users\\*\\AppData\\Roaming\\Microsoft\\Windows\\PowerShell\\PSReadLine\\*",
        "C:\\ProgramData\\Microsoft\\Search\\Data\\Applications\\Windows\\*",
        "C:\\Users\\*\\AppData\\Local\\Comms\\Unistore\\*",
        "C:\\Users\\*\\AppData\\Local\\Microsoft\\Windows\\*",
        "C:\\Windows\\ServiceProfiles\\NetworkService\\AppData\\Local\\Microsoft\\Windows\\DeliveryOptimization\\*",
        "C:\\Users\\*\\ntuser.dat.LOG2",
        "C:\\Windows\\ServiceProfiles\\NetworkService\\NTUSER.DAT",
        "C:\\Users\\*\\AppData\\Local\\Microsoft\\OneDrive\\logs\\ListSync\\*",
        "C:\\Windows\\ServiceState\\EventLog\\Data\\*",
        "C:\\Users\\*\\AppData\\Local\\Packages\\*",
        "C:\\Windows\\Logs\\CBS\\*",
        "C:\\Windows\\System32\\sru\\*",
        "C:\\Windows\\SoftwareDistribution\\DataStore\\Logs\\*",
        "C:\\Users\\*\\AppData\\Local\\Microsoft\\OneDrive\\logs\\*",
        "C:\\Program Files\\SplunkUniversalForwarder\\*",
        "C:\\Program Files (x86)\\Microsoft\\Copilot\\*"
    ],
    "DontInject": [
        "PanoptesService.exe",
        "PanoptesContainer.exe",
        "PanoptesDetector.exe",
        "C:\\Program Files\\SplunkUniversalForwarder\\bin\\*",
        "OUTLOOK.EXE",
        "olk.exe",
        "msedge.exe"
    ],
    "FileEvents": [
        "Create",
        "Write",
        "DeleteRename",
        "PipeMailslot",
        "Security",
        "ExtendedAttributes"
    ],
    "QuarantineMaliciousFiles": true,
    "EnforceDetectionActions": false
}
